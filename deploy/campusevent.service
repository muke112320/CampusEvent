[Unit]
Description=CampusEvent Flask application (gunicorn, /campusevent)
After=network.target

[Service]
Type=simple
User=campusevent
Group=campusevent
WorkingDirectory=/opt/campusevent
Environment="CAMPUSEVENT_URL_PREFIX=/campusevent"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/campusevent/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8001 --access-logfile - --error-logfile - wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
